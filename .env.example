# ── LLM ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── Database ─────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=<random-64-char-hex>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MIN=30
REFRESH_TOKEN_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── Firebase Admin (backend) ─────────────────────────────────────────
# Path to service account JSON (local)
FIREBASE_CREDENTIALS=backend/credentials/firebase-service-account.json

# ── Firebase Client (frontend — Vite) ────────────────────────────────
VITE_API_URI=http://127.0.0.1:8000/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── SMS (MSG91) ───────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SWASTH
MSG91_ROUTE=4
MSG91_COUNTRY_CODE=91

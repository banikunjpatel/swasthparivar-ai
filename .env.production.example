# ── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=<64-char-random-hex>    # openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MIN=30
REFRESH_TOKEN_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL and the EC2 domain
ALLOWED_ORIGINS=https://your-app.vercel.app,https://api.swasthparivar.com

# ── Firebase Admin (backend) ─────────────────────────────────────────────────
# Path inside the container (mounted from ./backend/credentials/)
FIREBASE_CREDENTIALS=/app/credentials/firebase-service-account.json

# ── Gunicorn workers ─────────────────────────────────────────────────────────
# t3.small (2 vCPU) → 2-4 workers.  t3.medium (2 vCPU, 4GB) → 4 workers.
WEB_CONCURRENCY=2

# ── Frontend (Vite build vars — set in Vercel dashboard, not here) ───────────
# VITE_API_URI=https://api.swasthparivar.com/api/v1
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

{
"$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "meal_plan_family.json",
  "title": "Weekly Meal Plan (Single or Family)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "diet_type": {
      "type": "string",
      "enum": ["veg", "non_veg", "eggs_ok"]
    },
    "constitution": {
      "type": "string",
      "enum": ["vata", "pitta", "kapha", "vata-pitta", "pitta-kapha", "vata-kapha", "tridoshic"]
    },

    "week_plan": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ]
          },
          "meals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "morning": { "type": "string", "minLength": 1 },
              "breakfast": { "type": "string", "minLength": 1 },
              "lunch": { "type": "string", "minLength": 1 },
              "evening": { "type": "string", "minLength": 1 },
              "dinner": { "type": "string", "minLength": 1 }
            },
            "required": ["morning", "breakfast", "lunch", "evening", "dinner"]
          }
        },
        "required": ["day", "meals"]
      }
    },

    "key_guidelines": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "regional_notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_region_focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparison_with_previous_region": {
          "type": "boolean"
        }
      },
      "required": ["current_region_focus", "comparison_with_previous_region"]
    },

    "previous_region_comparison": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": ["string", "null"]
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["from", "to", "notes"]
    }
  },

  "required": [
    "title",
    "subtitle",
    "region",
    "diet_type",
    "constitution",
    "week_plan",
    "key_guidelines",
    "regional_notes"
  ]
}
